# Copy to .env. Never commit .env.
APP_ENV=local
# Local Docker PostgreSQL. Works both when the backend runs on your machine and in the api
# container (docker compose points "localhost" at the postgres container).
DATABASE_URL=postgresql+asyncpg://rehabgraph:rehabgraph@localhost:5432/rehabgraph
# Or Neon: paste the connection string from the Neon console as is (sslmode / channel_binding are
# converted for asyncpg). Use the direct host (no "-pooler") for migrations.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
# Embedding model not chosen yet (BACKEND-ARCHITECTURE section 1).
EMBEDDING_MODEL=
CENTER_NAME=Trung tâm PHCN
CENTER_DOMAIN=localhost
GUEST_FREE_QUESTIONS=5
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
