# Only variables starting with VITE_ go into the bundle. Never put secrets here.
# Local `pnpm dev`: the API on your machine. In Docker (http://localhost:8080) leave it empty:
# nginx forwards /api to the api container on the same origin.
VITE_API_BASE_URL=http://localhost:8000
VITE_CENTER_NAME=Trung tâm PHCN
VITE_CAPTCHA_SITE_KEY=
